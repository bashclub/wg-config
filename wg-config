#!/bin/bash

# This script creates a wireguard configuration for both sides

prog="$(basename $0)"

# Generated files contain private keys
umask 077

a_name=side-a
a_file=""
a_keyfile=""
a_print_qr=0
a_print_opn=0

b_name=side-b
b_file=""
b_keyfile=""
b_print_qr=0
b_print_opn=0

port=51820
b_port=""
persistent_keepalive=25

if ! which wg > /dev/null; then
    echo "Please install wireguard before running this script!"
    exit 1
fi

usage() {
	cat >&2 <<-EOF
	usage: $prog [-h]
	  creates a wireguard configuration for both endpoints

    -a NAME              Name of side A (OPNsense instance/peer name, default: $a_name)
    -e ENDPOINT_ADDR     Endpoint address on side A (omit for clients without fixed address)
    -t TUNNEL_ADDR       Tunnel address on side A
    -n NETWORKS          CIDR formatted networks accessible on side A (comma separated)
    -d DNS               DNS servers and suffixes accessible on side A (comma separated)
    -r KEY_OR_CONF       Reuse the private key of side A (key file or existing wg config)
    -f FILENAME          Save side A to specified file (default: ./NAME.conf)
    -q                   Print side A as QR code
    -o                   Print side A as OPNsense values

    -A NAME              Name of side B (OPNsense instance/peer name, default: $b_name)
    -E ENDPOINT          Endpoint address on side B (omit for clients without fixed address)
    -T TUNNEL_ADDR       Tunnel address on side B
    -N NETWORKS          CIDR formatted networks accessible on side B (comma separated)
    -D DNS               DNS servers and suffixes accessible on side B (comma separated)
    -R KEY_OR_CONF       Reuse the private key of side B (key file or existing wg config)
    -F FILENAME          Save side B to specified file (default: ./NAME.conf)
    -Q                   Print side B as QR code
    -O                   Print side B as OPNsense values

    -p PORT              UDP port of side A (and of side B unless -P is set, default: $port)
    -P PORT              UDP port of side B (e.g. the port a FRITZ!Box chose itself)
    -k KEEPALIVE         Override PersistentKeepalive (default: $persistent_keepalive)

    -h                   displays this help text
  ---------------------------------------------------------------------------
    (C) 2023             wg-creator by bashclub (https://github.com/bashclub)
                 Author: Thorsten Spille <thorsten@spille-edv.de>
  ---------------------------------------------------------------------------
	EOF
	exit $1
}

while getopts "a:e:t:n:d:r:f:qoA:E:T:N:D:R:F:QOp:P:k:h" opt; do
  case $opt in
    h) usage 0 ;;
    a) a_name=$OPTARG ;;
    A) b_name=$OPTARG ;;
    e) a_endpoint_address=$OPTARG ;;
    E) b_endpoint_address=$OPTARG ;;
    t) a_tunnel_address=$OPTARG ;;
    T) b_tunnel_address=$OPTARG ;;
    n) a_networks=$OPTARG ;;
    N) b_networks=$OPTARG ;;
    d) a_dns=$OPTARG ;;
    D) b_dns=$OPTARG ;;
    r) a_keyfile=$OPTARG ;;
    R) b_keyfile=$OPTARG ;;
    f) a_file=$OPTARG ;;
    F) b_file=$OPTARG ;;
    q) a_print_qr=1 ;;
    Q) b_print_qr=1 ;;
    o) a_print_opn=1 ;;
    O) b_print_opn=1 ;;
    p) port=$OPTARG ;;
    P) b_port=$OPTARG ;;
    k) persistent_keepalive=$OPTARG ;;
    *) usage 1 ;;
  esac
done
shift $((OPTIND-1))

if [ -z "$a_tunnel_address" ] || [ -z "$b_tunnel_address" ]; then
    echo "Tunnel addresses of both sides are required (-t and -T)." >&2
    usage 1
fi

if [ $a_print_qr -gt 0 ] || [ $b_print_qr -gt 0 ]; then
    if ! which qrencode > /dev/null; then
        echo "Please install qrencode to print QR codes!"
        exit 1
    fi
fi

a_port=$port
b_port=${b_port:-$port}

a_file=${a_file:-./${a_name}.conf}
b_file=${b_file:-./${b_name}.conf}

# private key: from file (plain key or wg config with PrivateKey) or new
read_privkey() {
    if [ -z "$1" ]; then
        wg genkey
    elif grep -q '^ *PrivateKey' "$1"; then
        sed -n 's/^ *PrivateKey *= *//p' "$1" | head -n1
    else
        head -n1 "$1"
    fi
}

a_privkey=$(read_privkey "$a_keyfile") || exit 1
b_privkey=$(read_privkey "$b_keyfile") || exit 1
a_pubkey=$(echo "$a_privkey" | wg pubkey) || { echo "Invalid private key for side A" >&2; exit 1; }
b_pubkey=$(echo "$b_privkey" | wg pubkey) || { echo "Invalid private key for side B" >&2; exit 1; }
psk=$(wg genpsk)

# AllowedIPs of a peer: its tunnel address as /32 plus its networks
allowed_ips() {
    local ips="${1%%/*}/32"
    [ -n "$2" ] && ips="$ips,$2"
    echo "$ips"
}
a_allowed=$(allowed_ips "$a_tunnel_address" "$a_networks")
b_allowed=$(allowed_ips "$b_tunnel_address" "$b_networks")

# write_conf FILE PRIVKEY ADDRESS DNS PEER_PUBKEY PEER_ALLOWED PEER_ENDPOINT OWN_PORT PEER_PORT
write_conf() {
    {
        echo "[Interface]"
        echo "PrivateKey = $2"
        echo "Address = $3"
        [ -n "$4" ] && echo "DNS = $4"
        echo "ListenPort = $8"
        echo ""
        echo "[Peer]"
        echo "PublicKey = $5"
        echo "PresharedKey = $psk"
        echo "AllowedIPs = $6"
        if [ -n "$7" ]; then
            echo "Endpoint = $7:$9"
            echo "PersistentKeepalive = $persistent_keepalive"
        fi
    } > "$1"
}

# Field labels and order as in OPNsense: VPN > WireGuard > Instances / Peers
# print_opnsense NAME PUBKEY PRIVKEY TUNNEL DNS PEER_NAME PEER_PUBKEY PEER_ALLOWED PEER_ENDPOINT OWN_PORT PEER_PORT
print_opnsense() {
    local own_port=${10} peer_port=${11}
    echo "Enter the following values into OPNsense (empty = leave unchanged)"
    echo ""
    echo "VPN > WireGuard > Instances > +"
    printf '  %-22s%s\n' \
        "Enabled:" "yes" \
        "Name:" "$1" \
        "Public key:" "$2" \
        "Private key:" "$3" \
        "Listen port:" "$own_port" \
        "MTU:" "" \
        "DNS servers:" "$5" \
        "Tunnel address:" "$4" \
        "Depend on (CARP):" "" \
        "Peers:" "$6 (select after creating the peer)" \
        "Disable routes:" "no" \
        "Gateway:" ""
    echo ""
    echo "VPN > WireGuard > Peers > +"
    printf '  %-22s%s\n' \
        "Enabled:" "yes" \
        "Name:" "$6" \
        "Public key:" "$7" \
        "Pre-shared key:" "$psk" \
        "Allowed IPs:" "${8//,/ }" \
        "Endpoint address:" "$9" \
        "Endpoint port:" "$( [ -n "$9" ] && echo "$peer_port")" \
        "Instances:" "$1" \
        "Keepalive interval:" "$( [ -n "$9" ] && echo "$persistent_keepalive")"
    echo ""
    echo "  Allowed IPs: enter each network as a separate entry."
    [ -n "$5" ] && echo "  DNS servers: overrides the DNS settings of OPNsense - usually leave empty."
    echo ""
}

# print_side TITLE FILE PRINT_QR PRINT_OPN ...print_opnsense arguments
print_side() {
    echo -e "$1\n-----\n"
    if [ "$3" -gt 0 ]; then
        qrencode -t ansiutf8 < "$2"
    elif [ "$4" -gt 0 ]; then
        shift 4
        print_opnsense "$@"
    else
        cat "$2"
        echo ""
    fi
}

write_conf "$a_file" "$a_privkey" "$a_tunnel_address" "$b_dns" "$b_pubkey" "$b_allowed" "$b_endpoint_address" "$a_port" "$b_port"
write_conf "$b_file" "$b_privkey" "$b_tunnel_address" "$a_dns" "$a_pubkey" "$a_allowed" "$a_endpoint_address" "$b_port" "$a_port"

print_side "SIDE A ($a_name, saved to $a_file)" "$a_file" $a_print_qr $a_print_opn \
    "$a_name" "$a_pubkey" "$a_privkey" "$a_tunnel_address" "$b_dns" \
    "$b_name" "$b_pubkey" "$b_allowed" "$b_endpoint_address" "$a_port" "$b_port"
print_side "SIDE B ($b_name, saved to $b_file)" "$b_file" $b_print_qr $b_print_opn \
    "$b_name" "$b_pubkey" "$b_privkey" "$b_tunnel_address" "$a_dns" \
    "$a_name" "$a_pubkey" "$a_allowed" "$a_endpoint_address" "$b_port" "$a_port"
